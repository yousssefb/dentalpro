<?xml version="1.0" encoding="UTF-8"?>
<!-- Configuration Maven du projet DentalPro (DentalSoft V1.0), alignée sur le JDK 27. -->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

  <modelVersion>4.0.0</modelVersion>

  <!-- Identité Maven du projet. -->
  <groupId>ma.dentalpro</groupId>
  <artifactId>dentalpro</artifactId>
  <version>1.0-SNAPSHOT</version>
  <packaging>jar</packaging>
  <name>DentalPro</name>
  <description>Application de gestion de cabinet dentaire (Java Swing, JDBC, MySQL)</description>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

    <!-- Version Java centrale du projet : source, target et release suivent cette valeur. -->
    <java.version>27</java.version>
    <maven.compiler.source>${java.version}</maven.compiler.source>
    <maven.compiler.target>${java.version}</maven.compiler.target>
    <maven.compiler.release>${java.version}</maven.compiler.release>

    <!-- Classe principale lancée par "mvn exec:java" et inscrite dans le manifeste du JAR. -->
    <main.class>ma.dentalpro.App</main.class>

    <!-- Versions centralisées des dépendances. -->
    <lombok.version>1.18.48</lombok.version>
    <!-- Pilote JDBC aligné sur le serveur MySQL 8.4 LTS. -->
    <mysql.connector.version>8.4.0</mysql.connector.version>
    <junit.version>5.13.4</junit.version>

    <!-- Versions centralisées des plugins. -->
    <maven.compiler.plugin.version>3.14.1</maven.compiler.plugin.version>
    <maven.enforcer.plugin.version>3.6.2</maven.enforcer.plugin.version>
    <maven.surefire.plugin.version>3.5.3</maven.surefire.plugin.version>
    <maven.jar.plugin.version>3.4.2</maven.jar.plugin.version>
    <exec.maven.plugin.version>3.5.1</exec.maven.plugin.version>
  </properties>

  <dependencies>
    <!-- Pilote JDBC officiel pour MySQL 8.x. -->
    <dependency>
      <groupId>com.mysql</groupId>
      <artifactId>mysql-connector-j</artifactId>
      <version>${mysql.connector.version}</version>
    </dependency>

    <!-- Lombok : getters, setters et constructeurs générés à la compilation (non inclus dans le JAR). -->
    <dependency>
      <groupId>org.projectlombok</groupId>
      <artifactId>lombok</artifactId>
      <version>${lombok.version}</version>
      <scope>provided</scope>
    </dependency>

    <!-- JUnit 5 pour les tests unitaires. -->
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>${junit.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!-- Compile le code avec javac en ciblant strictement Java 27. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>${maven.compiler.plugin.version}</version>
        <configuration>
          <release>${maven.compiler.release}</release>
          <!-- Lombok doit être déclaré comme processeur d'annotations depuis le JDK 23. -->
          <annotationProcessorPaths>
            <path>
              <groupId>org.projectlombok</groupId>
              <artifactId>lombok</artifactId>
              <version>${lombok.version}</version>
            </path>
          </annotationProcessorPaths>
        </configuration>
      </plugin>

      <!-- Interrompt Maven s'il n'est pas exécuté avec un JDK 27. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <version>${maven.enforcer.plugin.version}</version>
        <executions>
          <execution>
            <id>verifier-jdk-27</id>
            <goals>
              <goal>enforce</goal>
            </goals>
            <configuration>
              <rules>
                <requireJavaVersion>
                  <version>[27,28)</version>
                  <message>DentalPro doit être construit avec le JDK 27.</message>
                </requireJavaVersion>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <!--
        Exécute les tests JUnit 5 : tests unitaires (*Test) et tests d'intégration MySQL (*IT).
        Les *IT sont ignorés automatiquement si db.properties est absent ou MySQL arrêté.
      -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>${maven.surefire.plugin.version}</version>
        <configuration>
          <includes>
            <include>**/*Test.java</include>
            <include>**/*IT.java</include>
          </includes>
        </configuration>
      </plugin>

      <!-- Inscrit la classe principale dans le manifeste du JAR. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <version>${maven.jar.plugin.version}</version>
        <configuration>
          <archive>
            <manifest>
              <mainClass>${main.class}</mainClass>
            </manifest>
          </archive>
        </configuration>
      </plugin>

      <!-- Permet de lancer l'application avec : mvn compile exec:java -->
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <version>${exec.maven.plugin.version}</version>
        <configuration>
          <mainClass>${main.class}</mainClass>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
